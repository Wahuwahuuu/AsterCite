{
  "name": "astercite",
  "version": "1.2.0",
  "private": true,
  "description": "A research paper question-answering workspace with a web interface and CLI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "astercite": "agent/cli.ts"
  },
  "scripts": {
    "paper": "node agent/cli.ts",
    "demo": "node scripts/demo.ts",
    "doctor": "node scripts/doctor.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/agent/*.test.ts",
    "test:public": "python -X utf8 -m unittest discover -s tests/scripts -v",
    "audit": "python -X utf8 scripts/audit_public.py",
    "web": "node agent/web-server.ts",
    "start": "node desktop/local-app.ts",
    "web:build": "node scripts/build-web.ts",
    "web:vendor": "node scripts/sync-web-renderer.ts"
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "dompurify": "3.4.17",
    "katex": "0.19.1",
    "marked": "18.1.2",
    "pdfjs-dist": "6.4.299",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-codemode": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@earendil-works/pi-telemetry": "1.0.4"
  }
}
